# OpenVibe.Cam — environment (production: /etc/openvibe/cam.env). Only names are committed; every value is set on
# the host. A secret is never printed, logged or committed.

# ── The service ──
NODE_ENV=production
PORT=5160
HOST=127.0.0.1
BASE_URL=https://openvibe.cam
TRUST_PROXY=2
CAM_DRILL=0

# ── PostgreSQL (ADR-035) and Valkey ──
DATABASE_URL=postgres://cam:...@127.0.0.1:6432/cam
DATABASE_DIRECT_URL=postgres://cam_owner:...@127.0.0.1:5432/cam
# CAM_PGLITE_DIR=/opt/openvibe.cam/data/pglite
# VALKEY_URL=redis://127.0.0.1:6379
VALKEY_PREFIX=ov:cam:

# ── OpenVibe.Network: SSO (OAuth client cam, PKCE S256) and JWKS ──
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_NETWORK_ISSUER=https://openvibe.network
OV_OAUTH_CLIENT_ID=cam
OV_OAUTH_CLIENT_SECRET=...
OV_OAUTH_REDIRECT_URI=https://openvibe.cam/auth/callback
OV_SESSION_AUDIENCE=openvibe.network
CAM_AUDIENCE=openvibe.cam
COOKIE_SECURE=true

# ── OpenVibe.Events → /internal/events (account export/deletion) ──
CAM_EVENTS_SECRET=...
CAM_EVENTS_URL=https://openvibe.events
CAM_EVENTS_ENDPOINT=https://openvibe.cam/internal/events
CAM_EVENTS_INTERVAL_MS=5000
CAM_EVENTS_SCOPE=events.subscription.manage

# ── The existing public APIs Cam uses ──
OV_MEDIA_URL=https://openvibe.media
OV_LIVE_URL=https://openvibe.live
OV_PICS_URL=https://openvibe.pics
CAM_UPSTREAM_TIMEOUT_MS=8000

# ── Photos, stills, cameras and grants ──
CAM_PHOTO_MAX_BYTES=12582912
CAM_STILL_MAX_BYTES=8388608
CAM_STILL_WIDTH=640
CAM_MAX_CAMERAS=20
CAM_GRANT_DAYS=7
CAM_GRANT_MAX_DAYS=90
CAM_GRANTS_PER_CAMERA=50
CAM_LIMITS_MINUTE=120
CAM_LIMITS_HOUR=3000
# CAM_API_RATE_LIMIT_PER_MIN=240
# CAM_RATE_LIMIT_PER_MIN=300
