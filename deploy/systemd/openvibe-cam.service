[Unit]
Description=OpenVibe.Cam — the camera app, private cameras and viewer grants, and the still Live's cam button takes.
# Network (sign-in, JWKS, identity resolve, account events) should be up first, but Cam degrades honestly without it:
# the public pages serve, and sign-in and the guarded routes wait for the signing key (see /api/ready).
After=network.target postgresql.service pgbouncer.service valkey-server.service
Wants=openvibe-network.service postgresql.service pgbouncer.service valkey-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvibe.cam
EnvironmentFile=/etc/openvibe/cam.env
Environment=NODE_ENV=production
Environment=PORT=5160
Environment=HOST=127.0.0.1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/openvibe.cam/server/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
# In-flight requests get the 10 s drain.
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# OpenVibe.Cam's own database is PostgreSQL on the host's data role; the code tree stays read-only.

[Install]
WantedBy=multi-user.target
